rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // A room member may see the check-in photos for rooms they belong to;
    // photos can only ever be written under the capturing user's own uid.
    function isRoomMember(roomId) {
      return request.auth != null
        && request.auth.uid in get(/databases/(default)/documents/rooms/$(roomId)).data.members;
    }

    match /rooms/{roomId}/checkins/{uid}/{fileName} {
      allow read: if isRoomMember(roomId);
      allow write: if isRoomMember(roomId)
        && uid == request.auth.uid
        && fileName.matches('.*\\.jpg$');
    }
  }
}
